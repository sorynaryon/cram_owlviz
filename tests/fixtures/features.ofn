# OWL Functional Syntax features the parser must handle; features-ofn.nt is the same ontology converted by the OWL API (ROBOT).
Prefix(:=<http://example.org/f#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)

Ontology(<http://example.org/f>
<http://example.org/f/1.0>
Annotation(rdfs:comment "Functional syntax features"@en)

Declaration(Class(:Robot))
Declaration(Class(:Agent))
Declaration(Class(:Arm))
Declaration(Class(:DualArmRobot))
Declaration(Class(:Gripper))
Declaration(Class(:A))
Declaration(Class(:B))
Declaration(Class(:C))
Declaration(ObjectProperty(:hasArm))
Declaration(ObjectProperty(:hasPart))
Declaration(ObjectProperty(:partOf))
Declaration(DataProperty(:mass))
Declaration(AnnotationProperty(:note))
Declaration(NamedIndividual(:pr2))
Declaration(NamedIndividual(:left))
Declaration(NamedIndividual(:right))

SubClassOf(:Robot :Agent)
SubClassOf(Annotation(rdfs:comment "an axiom annotation is dropped") :Arm ObjectSomeValuesFrom(:partOf :Robot))
EquivalentClasses(:DualArmRobot ObjectIntersectionOf(:Robot ObjectMinCardinality(2 :hasArm :Arm)))
SubClassOf(:Gripper ObjectUnionOf(:A ObjectComplementOf(:B)))
SubClassOf(:Gripper DataSomeValuesFrom(:mass DatatypeRestriction(xsd:double xsd:minInclusive "0.0"^^xsd:double)))
SubClassOf(:Gripper ObjectAllValuesFrom(ObjectInverseOf(:hasPart) :Arm))
SubClassOf(:A ObjectHasValue(:hasPart :left))
SubClassOf(:A DataMaxCardinality(1 :mass))
DisjointClasses(:A :B :C)
DisjointClasses(:Arm :Robot)
SubObjectPropertyOf(:hasArm :hasPart)
SubObjectPropertyOf(ObjectPropertyChain(:hasPart :hasPart) :hasPart)
InverseObjectProperties(:hasPart :partOf)
TransitiveObjectProperty(:hasPart)
ObjectPropertyDomain(:hasArm :Robot)
ObjectPropertyRange(:hasArm :Arm)
FunctionalDataProperty(:mass)
DataPropertyRange(:mass xsd:double)
ClassAssertion(:Robot :pr2)
ObjectPropertyAssertion(:hasArm :pr2 :left)
ObjectPropertyAssertion(:hasArm :pr2 :right)
DataPropertyAssertion(:mass :pr2 "200.5"^^xsd:double)
DifferentIndividuals(:left :right)
AnnotationAssertion(rdfs:label :Robot "Robot"@en)
AnnotationAssertion(rdfs:label :Robot "Roboter"@de)
AnnotationAssertion(:note :Robot "with \"quotes\" and # hash")
AnnotationAssertion(rdfs:seeAlso :Robot <http://example.org/doc>)
)
